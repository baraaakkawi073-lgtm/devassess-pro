# ---------------------------------------------------------------------------
# DevAssess Pro - environment configuration (copy to .env at the repository root)
# ---------------------------------------------------------------------------

# --- API server (server/) ---------------------------------------------------
# Port the Express API listens on.
PORT=5000
# development | production | test
NODE_ENV=development
# Allowed browser origin for CORS (only needed if you do not use the Vite proxy).
CLIENT_ORIGIN=http://localhost:3000
# Max requests per IP per 15-minute window on /api.
RATE_LIMIT_MAX=300

# --- Web client (client/) ---------------------------------------------------
# Target used by the Vite dev-server proxy for /api requests.
VITE_API_PROXY=http://localhost:5000
# Absolute API base URL. Leave unset to use the same-origin "/api" path
# (works with the Vite proxy in dev and with the bundled Express server in prod).
# VITE_API_URL=http://localhost:5000/api
